#include <WiFi.h>
#include <WiFiUdp.h>
#include <math.h>

// =====================================================
// WIFI
// =====================================================

const char* WIFI_SSID ="ll";
const char* WIFI_PASSWORD = "s";

// =====================================================
// NETWORK
// =====================================================

const uint16_t TCP_PORT = 5000;
const uint16_t UDP_PORT = 4210;

WiFiUDP udp;
WiFiClient client;

// =====================================================
// SIGNAL
// =====================================================

const uint32_t SAMPLE_RATE = 20000;
const uint32_t DURATION_SECONDS = 10;

const uint32_t TOTAL_SAMPLES =
    SAMPLE_RATE * DURATION_SECONDS;

const uint16_t SAMPLES_PER_PACKET = 500;

// =====================================================
// PACKET
// =====================================================

struct DataPacket
{
    uint64_t timestampUs;

    uint32_t sequence;

    int16_t samples[SAMPLES_PER_PACKET];
};

// =====================================================
// RECORDING CYCLE
//
// 0 = EARLY  -> event around 1.5 - 2.0 sec
// 1 = MIDDLE -> event around 5.0 - 5.5 sec
// 2 = LATE   -> event around 8.0 - 8.5 sec
//
// Then repeats.
// =====================================================

uint8_t recordingCycle = 0;

// =====================================================
// RANDOM NOISE
// =====================================================

float randomNoise(float amplitude)
{
    float r =
        (float)random(-10000, 10001) / 10000.0f;

    return r * amplitude;
}

// =====================================================
// VARIABLE BACKGROUND FREQUENCY
// =====================================================
//
// This is the normal background signal.
// It continuously changes during the 10 seconds.
//
// 0 - 2 sec    : 200 -> 1200 Hz
// 2 - 4 sec    : 1200 -> 5000 Hz
// 4 - 6 sec    : 5000 -> 800 Hz
// 6 - 8 sec    : 800 -> 3500 Hz
// 8 - 10 sec   : 3500 -> 200 Hz
// =====================================================

float getFrequency(float t)
{
    // ---------------------------------------------
    // 0 - 2 sec
    // ---------------------------------------------

    if (t < 2.0f)
    {
        float p = t / 2.0f;

        return 200.0f +
               p * (1200.0f - 200.0f);
    }

    // ---------------------------------------------
    // 2 - 4 sec
    // ---------------------------------------------

    else if (t < 4.0f)
    {
        float p =
            (t - 2.0f) / 2.0f;

        return 1200.0f +
               p * (5000.0f - 1200.0f);
    }

    // ---------------------------------------------
    // 4 - 6 sec
    // ---------------------------------------------

    else if (t < 6.0f)
    {
        float p =
            (t - 4.0f) / 2.0f;

        return 5000.0f +
               p * (800.0f - 5000.0f);
    }

    // ---------------------------------------------
    // 6 - 8 sec
    // ---------------------------------------------

    else if (t < 8.0f)
    {
        float p =
            (t - 6.0f) / 2.0f;

        return 800.0f +
               p * (3500.0f - 800.0f);
    }

    // ---------------------------------------------
    // 8 - 10 sec
    // ---------------------------------------------

    else
    {
        float p =
            (t - 8.0f) / 2.0f;

        return 3500.0f +
               p * (200.0f - 3500.0f);
    }
}

// =====================================================
// GET CURRENT DOMINANT EVENT POSITION
// =====================================================

float getEventStart()
{
    if (recordingCycle == 0)
    {
        // EARLY
        return 1.5f;
    }

    else if (recordingCycle == 1)
    {
        // MIDDLE
        return 5.0f;
    }

    else
    {
        // LATE
        return 8.0f;
    }
}

// =====================================================
// SIGNAL GENERATOR
// =====================================================

int16_t generateSample(uint32_t sampleIndex)
{
    float t =
        (float)sampleIndex /
        SAMPLE_RATE;

    // =================================================
    // BACKGROUND VARIABLE FREQUENCY
    // =================================================

    float f =
        getFrequency(t);

    float signal =
        0.60f *
        sinf(
            2.0f *
            PI *
            f *
            t
        );

    // =================================================
    // FIXED BACKGROUND COMPONENT
    // =================================================

    signal +=
        0.18f *
        sinf(
            2.0f *
            PI *
            1200.0f *
            t
        );

    // =================================================
    // SECOND FIXED COMPONENT
    // =================================================

    signal +=
        0.12f *
        cosf(
            2.0f *
            PI *
            2800.0f *
            t
        );

    // =================================================
    // SIDEBAND COMPONENT
    // =================================================

    float f3 = 300.0f;
    float f4 = 2500.0f;

    signal +=
        0.15f *
        sinf(
            2.0f *
            PI *
            f4 *
            t
        ) *
        cosf(
            2.0f *
            PI *
            f3 *
            t
        );

    // =================================================
    // MOVING SIMULATED BAT IMPACT
    // =================================================

    float eventStart =
        getEventStart();

    float eventEnd =
        eventStart + 0.50f;

    if (t >= eventStart && t <= eventEnd)
    {
        // Time inside event
        float eventTime =
            t - eventStart;

        // Exponential decay
        float envelope =
            expf(
                -7.0f *
                eventTime
            );

        // ---------------------------------------------
        // Dominant impact frequencies
        // ---------------------------------------------

        float impact =
            sinf(
                2.0f *
                PI *
                2200.0f *
                t
            );

        impact +=
            0.7f *
            sinf(
                2.0f *
                PI *
                3200.0f *
                t
            );

        impact +=
            0.4f *
            sinf(
                2.0f *
                PI *
                3900.0f *
                t
            );

        // ---------------------------------------------
        // Strong impact
        // ---------------------------------------------

        signal +=
            0.95f *
            envelope *
            impact;
    }

    // =================================================
    // RANDOM NOISE
    // =================================================

    signal +=
        randomNoise(0.08f);

    // =================================================
    // ADC-LIKE OUTPUT
    //
    // 0 - 4095
    // =================================================

    float adc =
        2048.0f +
        signal * 1500.0f;

    if (adc < 0)
        adc = 0;

    if (adc > 4095)
        adc = 4095;

    return (int16_t)adc;
}

// =====================================================
// UDP DISCOVERY
// =====================================================

IPAddress discoverServer()
{
    Serial.println();
    Serial.println(
        "Searching for UltraEdge Java server..."
    );

    udp.begin(UDP_PORT);

    IPAddress broadcast =
        WiFi.broadcastIP();

    for (
        int attempt = 0;
        attempt < 20;
        attempt++
    )
    {
        // -----------------------------------------
        // Send discovery message
        // -----------------------------------------

        udp.beginPacket(
            broadcast,
            UDP_PORT
        );

        udp.print(
            "ULTRAEDGE_DISCOVER"
        );

        udp.endPacket();

        Serial.print(
            "Discovery attempt "
        );

        Serial.println(
            attempt + 1
        );

        // -----------------------------------------
        // Wait for Java response
        // -----------------------------------------

        unsigned long start =
            millis();

        while (
            millis() - start <
            500
        )
        {
            int packetSize =
                udp.parsePacket();

            if (packetSize > 0)
            {
                char buffer[100];

                int len =
                    udp.read(
                        buffer,
                        sizeof(buffer) - 1
                    );

                if (len > 0)
                    buffer[len] = '\0';

                String response =
                    String(buffer);

                Serial.print(
                    "Discovery response: "
                );

                Serial.println(
                    response
                );

                if (
                    response.startsWith(
                        "ULTRAEDGE_SERVER"
                    )
                )
                {
                    IPAddress serverIP =
                        udp.remoteIP();

                    Serial.print(
                        "Java server found at: "
                    );

                    Serial.println(
                        serverIP
                    );

                    udp.stop();

                    return serverIP;
                }
            }

            delay(5);
        }
    }

    udp.stop();

    Serial.println(
        "Java server not found."
    );

    return IPAddress(
        0,
        0,
        0,
        0
    );
}

// =====================================================
// WAIT FOR START
// =====================================================

bool waitForStart()
{
    Serial.println(
        "Waiting for Java START..."
    );

    String command = "";

    unsigned long start =
        millis();

    while (
        millis() - start <
        30000
    )
    {
        if (client.available())
        {
            char c =
                client.read();

            if (c == '\n')
            {
                command.trim();

                Serial.print(
                    "Received: "
                );

                Serial.println(
                    command
                );

                if (
                    command ==
                    "START"
                )
                {
                    return true;
                }

                command = "";
            }
            else
            {
                command += c;
            }
        }

        delay(1);
    }

    return false;
}

// =====================================================
// SEND DATA
// =====================================================

void sendData()
{
    DataPacket packet;

    uint32_t sequence = 0;

    uint32_t sampleIndex = 0;

    uint32_t startTime =
        micros();

    // =================================================
    // PRINT WHICH CYCLE IS RUNNING
    // =================================================

    Serial.println();
    Serial.println(
        "========================================"
    );

    Serial.print(
        "STARTING 10 SECOND ACQUISITION - CYCLE "
    );

    Serial.println(
        recordingCycle + 1
    );

    Serial.println(
        "========================================"
    );

    Serial.print(
        "Dominant event starts at: "
    );

    Serial.print(
        getEventStart()
    );

    Serial.println(
        " seconds"
    );

    // =================================================
    // 10 SECOND ACQUISITION
    // =================================================

    while (
        sampleIndex <
        TOTAL_SAMPLES
    )
    {
        uint16_t count = 0;

        packet.timestampUs =
            micros() - startTime;

        packet.sequence =
            sequence;

        // -----------------------------------------
        // Generate samples
        // -----------------------------------------

        while (
            count <
            SAMPLES_PER_PACKET
            &&
            sampleIndex <
            TOTAL_SAMPLES
        )
        {
            packet.samples[count] =
                generateSample(
                    sampleIndex
                );

            sampleIndex++;

            count++;
        }

        // -----------------------------------------
        // Packet size
        // -----------------------------------------

        size_t packetSize =
            sizeof(uint64_t)
            +
            sizeof(uint32_t)
            +
            count *
            sizeof(int16_t);

        // -----------------------------------------
        // Send packet
        // -----------------------------------------

        size_t sent =
            client.write(
                (uint8_t*)&packet,
                packetSize
            );

        if (
            sent != packetSize
        )
        {
            Serial.println(
                "TCP send error."
            );

            break;
        }

        sequence++;

        // -----------------------------------------
        // Maintain 20 kHz
        // -----------------------------------------

        uint32_t targetTime =
            (
                (uint64_t)
                sampleIndex *
                1000000ULL
            )
            /
            SAMPLE_RATE;

        while (
            (
                micros() -
                startTime
            )
            <
            targetTime
        )
        {
            delayMicroseconds(1);
        }
    }

    // =================================================
    // ACQUISITION COMPLETE
    // =================================================

    Serial.println();

    Serial.println(
        "10 second acquisition complete."
    );

    Serial.print(
        "Samples sent: "
    );

    Serial.println(
        sampleIndex
    );

    client.println(
        "ACQUISITION_COMPLETE"
    );

    delay(100);

    client.stop();

    Serial.println(
        "TCP connection closed."
    );

    // =================================================
    // MOVE TO NEXT CYCLE
    //
    // 0 -> 1 -> 2 -> 0 -> 1 -> 2 ...
    // =================================================

    recordingCycle++;

    if (
        recordingCycle >= 3
    )
    {
        recordingCycle = 0;
    }

    Serial.print(
        "Next recording cycle: "
    );

    Serial.println(
        recordingCycle + 1
    );
}

// =====================================================
// CONNECT TO SERVER
// =====================================================

bool connectToServer()
{
    IPAddress serverIP =
        discoverServer();

    if (
        serverIP ==
        IPAddress(
            0,
            0,
            0,
            0
        )
    )
    {
        return false;
    }

    Serial.print(
        "Connecting TCP to "
    );

    Serial.println(
        serverIP
    );

    if (
        !client.connect(
            serverIP,
            TCP_PORT
        )
    )
    {
        Serial.println(
            "TCP connection failed."
        );

        return false;
    }

    Serial.println(
        "TCP connected."
    );

    client.println(
        "BAT_CONNECTED"
    );

    Serial.println(
        "BAT_CONNECTED sent."
    );

    return true;
}

// =====================================================
// SETUP
// =====================================================

void setup()
{
    Serial.begin(
        115200
    );

    delay(1000);

    randomSeed(
        analogRead(0)
    );

    Serial.println();

    Serial.println(
        "================================"
    );

    Serial.println(
        "UltraEdge Synthetic Signal"
    );

    Serial.println(
        "ESP32-C3"
    );

    Serial.println(
        "================================"
    );

    // ---------------------------------------------
    // WiFi
    // ---------------------------------------------

    WiFi.mode(
        WIFI_STA
    );

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.print(
        "Connecting to hotspot"
    );

    while (
        WiFi.status() !=
        WL_CONNECTED
    )
    {
        delay(500);

        Serial.print(".");
    }

    Serial.println();

    Serial.println(
        "WiFi connected."
    );

    Serial.print(
        "ESP IP: "
    );

    Serial.println(
        WiFi.localIP()
    );

    // ---------------------------------------------
    // Connect Java
    // ---------------------------------------------

    connectToServer();
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
    if (
        !client.connected()
    )
    {
        Serial.println(
            "TCP disconnected."
        );

        delay(1000);

        // Search again
        connectToServer();
    }

    if (
        client.connected()
    )
    {
        if (
            waitForStart()
        )
        {
            sendData();
        }
    }

    delay(100);
}
